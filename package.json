{
  "name": "plinthos",
  "version": "0.0.0",
  "private": true,
  "description": "A self-hosted catalogue for one LEGO collection.",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "open-next build",
    "pretypecheck": "sst install --config sst.types.config.ts --stage types",
    "posttypecheck": "tsc --noEmit -p infra",
    "db:generate": "drizzle-kit generate",
    "db:check": "tsx scripts/schema-check.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "auth:hash-password": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "3.1161.0",
    "@aws-sdk/client-dynamodb": "3.1161.0",
    "@aws-sdk/client-rds-data": "3.1161.0",
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-presigned-post": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "sst": "4.17.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@opennextjs/aws": "4.1.14",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "fake-indexeddb": "6.2.7",
    "happy-dom": "21.0.4",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  }
}
